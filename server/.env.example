PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/baore_cosmetics?replicaSet=rs0
# Must match the browser address exactly, including host and port.
# Use 127.0.0.1 so the page and the API at 127.0.0.1:5000 share the session cookie.
CLIENT_ORIGIN=http://127.0.0.1:5173

# Generate a random value of at least 32 characters and put it in server/.env.
# The server rejects this placeholder, a shorter value, and a repeated character.
# Do not commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret

# Session lifetime. Examples: 15m, 8h, 1d. Maximum 30d.
# When this line is omitted, the server uses 8h.
JWT_EXPIRES_IN=8h

# Required only by `npm run seed`. Leave these blank in the example file.
# Put the real starter passwords in server/.env, which is gitignored.
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# Optional. The seed script uses 12 when this is omitted.
# The administrator repair command also uses this cost when it is set.
# BCRYPT_COST=12

# Used only by `npm run repair:admin -- --execute`.
# The migration, seed, and server do not read this variable.
# Leave it blank here and put the real value in server/.env.
REPAIR_ADMIN_PASSWORD=
